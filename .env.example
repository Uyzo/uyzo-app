# Скопируйте этот файл в .env.local и подставьте значения из Supabase → Settings → API
# Публичный (publishable) ключ — безопасен для фронтенда
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# СЕКРЕТНЫЙ ключ — только сервер (форма подачи объявлений). НЕ NEXT_PUBLIC, во фронт не попадает.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
